# Copy this file to .env and fill in your real values
# NEVER commit .env to GitHub — it is listed in .gitignore

# From dev.mendeley.com/myapps.html
MENDELEY_CLIENT_ID=your_client_id_here
MENDELEY_CLIENT_SECRET=your_client_secret_here

# Run: python3 get_key.py <your-extension-id>
# Pins the Extension ID so it never changes between reloads
EXTENSION_KEY=your_extension_key_here
